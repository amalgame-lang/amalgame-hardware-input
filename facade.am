namespace Amalgame.Hardware.Input

// ── Amalgame.Hardware.Input — portable input drivers ─────
//
// Buttons and rotary encoders over Amalgame.Hal, so the same code runs
// on a Raspberry Pi (amalgame-hardware-gpio backend) and on a future
// MCU backend. The universal "controls" layer for menus, settings,
// e-stops, jog wheels…
//
//     import Amalgame.Hardware          // GpioIn, SysClock (Pi)
//     import Amalgame.Hardware.Input
//
//     let clk = new SysClock()
//     let btn = new Button(new GpioIn(17), clk, true)   // active-low
//     // in a loop:
//     btn.Update()
//     if (btn.WasPressed()) { … }
//
//     let enc = new RotaryEncoder(new GpioIn(5), new GpioIn(6))
//     let delta = enc.Poll()            // -1 / 0 / +1

import Amalgame.Hal

// A debounced push button on a DigitalIn. `activeLow=true` for the
// common wiring (button to GND + pull-up). Call Update() frequently;
// IsPressed() is the debounced level, WasPressed() fires once per press.
public class Button {
    private pin:          DigitalIn
    private clk:          Clock
    private activeLow:    bool
    private stable:       int   // debounced logical pressed (1/0)
    private lastRaw:      int
    private lastChangeMs: int
    private debounceMs:   int
    private pressedEvent: int

    public Button(pin: DigitalIn, clk: Clock, activeLow: bool) {
        this.pin          = pin
        this.clk          = clk
        this.activeLow    = activeLow
        this.debounceMs   = 20
        this.pressedEvent = 0
        let r: int = this.RawPressed()
        this.stable       = r
        this.lastRaw      = r
        this.lastChangeMs = this.clk.Millis()
    }

    public void SetDebounceMs(ms: int) { this.debounceMs = ms }

    private int RawPressed() {
        let v: int = this.pin.Read()
        if (this.activeLow) {
            if (v == 0) { return 1 }
            return 0
        }
        return v
    }

    // Sample + debounce. Call this regularly (every loop tick).
    public void Update() {
        let r: int = this.RawPressed()
        if (r != this.lastRaw) {
            this.lastRaw = r
            this.lastChangeMs = this.clk.Millis()
        } else {
            if (this.clk.Millis() - this.lastChangeMs >= this.debounceMs) {
                if (r != this.stable) {
                    this.stable = r
                    if (r == 1) { this.pressedEvent = 1 }
                }
            }
        }
    }

    public bool IsPressed() { return this.stable == 1 }

    // True once per debounced press (consumes the event).
    public bool WasPressed() {
        if (this.pressedEvent == 1) {
            this.pressedEvent = 0
            return true
        }
        return false
    }
}

// Incremental quadrature rotary encoder on two DigitalIn lines. Poll()
// returns the step taken since the previous call (-1, 0, or +1) by
// looking at channel B at the rising edge of channel A.
public class RotaryEncoder {
    private a:     DigitalIn
    private b:     DigitalIn
    private lastA: int

    public RotaryEncoder(a: DigitalIn, b: DigitalIn) {
        this.a = a
        this.b = b
        this.lastA = a.Read()
    }

    public int Poll() {
        let curA: int = this.a.Read()
        var delta: int = 0
        if (curA != this.lastA) {
            if (curA == 1) {
                if (this.b.Read() != curA) { delta = 1 } else { delta = 0 - 1 }
            }
        }
        this.lastA = curA
        return delta
    }
}

// Matrix keypad (e.g. the ubiquitous 4×4 membrane). Rows are driven as
// DigitalOut, columns read as DigitalIn (active-low: idle high via pull-
// ups, a press pulls the scanned column low). The keymap is a row-major
// string of one char per key — "123A456B789C*0#D" for the classic 4×4.
//
//     let rows = new List<DigitalOut>()   // R1..R4
//     let cols = new List<DigitalIn>()    // C1..C4
//     …populate from GpioOut/GpioIn…
//     let pad = new Keypad(rows, cols, "123A456B789C*0#D")
//     let k = pad.GetKey()                // "" when nothing pressed
public class Keypad {
    private rows:    List<DigitalOut>
    private cols:    List<DigitalIn>
    private keymap:  string
    private nCols:   int

    public Keypad(rows: List<DigitalOut>, cols: List<DigitalIn>, keymap: string) {
        this.rows   = rows
        this.cols   = cols
        this.keymap = keymap
        this.nCols  = cols.Count()
        // Idle: release every row high (active-low scan).
        var i: int = 0
        while (i < this.rows.Count()) { this.rows.Get(i).High(); i = i + 1 }
    }

    // Scan the matrix once; return the first pressed key as a 1-char
    // string, or "" if none. Pull one row low at a time and look for a
    // column that reads low.
    public string GetKey() {
        var r: int = 0
        var found: string = ""
        while (r < this.rows.Count()) {
            this.rows.Get(r).Low()
            var c: int = 0
            while (c < this.nCols) {
                if (this.cols.Get(c).Read() == 0) {
                    let idx: int = r * this.nCols + c
                    if (idx < String_Length(this.keymap)) {
                        found = String_Substring(this.keymap, idx, 1)
                    }
                }
                c = c + 1
            }
            this.rows.Get(r).High()
            if (String_Length(found) > 0) { return found }
            r = r + 1
        }
        return ""
    }

    // True if any key is currently down.
    public bool AnyPressed() { return String_Length(this.GetKey()) > 0 }
}
